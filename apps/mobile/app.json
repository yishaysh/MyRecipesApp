{
  "expo": {
    "name": "Social Recipe Extractor",
    "slug": "social-recipe-extractor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myrecipes.extractor"
    },
    "android": {
      "package": "com.myrecipes.extractor",
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": {
            "mimeType": "text/plain"
          }
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "516a0df7-2a2b-4a50-9ec3-f176e907f810"
      }
    },
    "owner": "yishaysh"
  }
}
