{
  "expo": {
    "name": "Social Recipe Extractor",
    "slug": "social-recipe-extractor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myrecipes.extractor"
    },
    "android": {
      "package": "com.myrecipes.extractor",
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": {
            "mimeType": "text/plain"
          }
        }
      ]
    },
    "web": {
      "bundler": "metro"
    }
  }
}
