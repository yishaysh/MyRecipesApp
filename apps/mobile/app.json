{
  "expo": {
    "name": "ספר המתכונים שלי",
    "slug": "social-recipe-extractor",
    "version": "1.0.0",
    "scheme": "myrecipes",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myrecipes.extractor",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.myrecipes.extractor",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#064e3b"
      },
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": {
            "mimeType": "text/plain"
          }
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-share-intent",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#064e3b"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "516a0df7-2a2b-4a50-9ec3-f176e907f810"
      }
    },
    "owner": "yishaysh"
  }
}
