# My Recipe Book (ספר המתכונים שלי) - Environment Variables Example
# Copy to .env for local development or configure in Vercel Project Settings.
# NEVER commit real secrets, API keys, or merchant credentials to git.

# --- Server & Database ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3001

# Neon Serverless Postgres connection string (leave empty for in-memory fallback)
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# --- Security & Authentication ---
# Strong random string used for JWT session tokens and HMAC-signed guest quota cookies
JWT_SECRET=replace-with-long-random-secret

# Admin portal password (/admin)
ADMIN_PASSWORD=replace-with-strong-admin-password

# Google OAuth Client IDs
GOOGLE_CLIENT_ID=replace-with-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=replace-with-android-oauth-client-id.apps.googleusercontent.com

# --- AI Recipe Extraction ---
GEMINI_API_KEY=replace-with-gemini-api-key
OPENAI_API_KEY=

# --- VIP & Promo Overrides ---
VIP_EMAILS=vip@example.com
PROMO_CODES=CODE1,CODE2

# --- Billing & Subscriptions (Payment Scaffolding) ---
# Set BILLING_TEST_MODE=1 for mock test checkout (no real charge).
# Set BILLING_TEST_MODE=0 ONLY when real merchant credentials below are verified in production.
BILLING_TEST_MODE=1
BILLING_PROVIDER=cardcom

# Shared HMAC secret for internal test webhooks or override webhook verification
BILLING_WEBHOOK_SECRET=replace-with-webhook-signing-secret

# Cardcom REST v11 Credentials (Israel) - Leave blank until Cardcom merchant account is active
CARDCOM_TERMINAL_NUMBER=
CARDCOM_API_NAME=
CARDCOM_API_PASSWORD=
CARDCOM_WEBHOOK_SECRET=
CARDCOM_BASE_URL=https://secure.cardcom.solutions/api/v11

