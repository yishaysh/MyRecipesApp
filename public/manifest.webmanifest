{
  "name": "ספר המתכונים שלי",
  "short_name": "ספר המתכונים",
  "description": "חילוץ מתכונים חכם מסרטונים, טקסט וצילומי מסך",
  "lang": "he",
  "dir": "rtl",
  "display": "standalone",
  "orientation": "portrait",
  "start_url": "/app",
  "scope": "/",
  "theme_color": "#064e3b",
  "background_color": "#f4f9f5",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/app/share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}

