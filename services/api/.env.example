# ==========================================
# MyRecipesApp Backend Environment Variables
# ==========================================

# Port and Environment
PORT=3000
NODE_ENV=development

# Google Gemini API Key (Required for LLM parsing)
GEMINI_API_KEY=your_gemini_api_key_here

# Neon Serverless Postgres Connection String (From neon.tech)
DATABASE_URL=postgresql://user:password@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret for Session Management (Generate a random 32+ char string in production)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long

# Google OAuth 2.0 Web Client ID (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# VIP & Family Whitelist (Comma-separated emails that get lifetime unlimited Chef Pro)
VIP_EMAILS=yishaysh@gmail.com,family@example.com

# Secret Promo Codes for Free Family / VIP Upgrades (Comma-separated)
PROMO_CODES=FAMILY2026,CHEFVIP,MYRECIPESVIP

